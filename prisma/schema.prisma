// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & Users
// ---------------------------------------------------------------------------

enum PlanType {
  FREE
  PAID
}

model Company {
  id               String   @id @default(cuid())
  name             String
  plan             PlanType @default(FREE)
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                 User[]
  jobs                  Job[]
  notes                 Note[]
  files                 File[]
  tasks                 Task[]
  invites               Invite[]
  memberships           CompanyMembership[]
  orgUnits              OrgUnit[]
  workspaces            Workspace[]
  crews                 Crew[]
  workspaceAccessGrants WorkspaceAccessGrant[]
  jobAccessGrants       JobAccessGrant[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
  REMOVED
}

enum OrgUnitKind {
  COMPANY
  DIVISION
}

enum AccessPrincipalType {
  MEMBER
  CREW
  ORG_UNIT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED
}

model User {
  id             String    @id @default(cuid())
  companyId      String?
  email          String?   @unique // Nullable to support SMS invites
  emailVerified  DateTime?
  image          String?
  phone          String?   @unique
  name           String?
  role           Role      @default(MEMBER)
  hashedPassword String?

  company     Company?            @relation(fields: [companyId], references: [id])
  memberships CompanyMembership[]
  accounts    Account[]
  sessions    Session[]

  jobsCreated   Job[]
  notes         Note[]
  files         File[]
  tasksCreated  Task[]
  tasksAssigned Task[]           @relation("AssignedTasks")
  exports       Export[]
  markupMarks   FileMarkupMark[]
}

model CompanyMembership {
  id            String           @id @default(cuid())
  companyId     String
  userId        String
  role          Role             @default(MEMBER)
  status        MembershipStatus @default(ACTIVE)
  joinedAt      DateTime         @default(now())
  deactivatedAt DateTime?
  removedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  crewMemberships      CrewMembership[]
  orgUnitMemberships   OrgUnitMembership[]
  workspaceGrantsMade  WorkspaceAccessGrant[] @relation("WorkspaceGrantCreator")
  jobGrantsMade        JobAccessGrant[]       @relation("JobGrantCreator")
  invitesSent          Invite[]               @relation("InviteSender")

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Invite {
  id         String    @id @default(cuid())
  companyId  String
  email      String
  role       Role      @default(MEMBER)
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  canceledAt DateTime?
  invitedByMembershipId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedByMembership CompanyMembership?          @relation("InviteSender", fields: [invitedByMembershipId], references: [id])
  orgUnitAssignments  InviteOrgUnitAssignment[]
  crewAssignments     InviteCrewAssignment[]
  workspaceAssignments InviteWorkspaceAssignment[]

  @@unique([companyId, email])
  @@index([email])
  @@index([companyId, status])
}

model OrgUnit {
  id              String      @id @default(cuid())
  companyId       String
  parentOrgUnitId String?
  name            String
  kind            OrgUnitKind @default(DIVISION)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent            OrgUnit?                   @relation("OrgUnitTree", fields: [parentOrgUnitId], references: [id])
  children          OrgUnit[]                  @relation("OrgUnitTree")
  workspaces        Workspace[]
  crews             Crew[]
  memberships       OrgUnitMembership[]
  inviteAssignments InviteOrgUnitAssignment[]

  @@index([companyId, kind])
  @@index([parentOrgUnitId])
}

model Workspace {
  id        String   @id @default(cuid())
  companyId String
  orgUnitId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnit           OrgUnit                     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  jobs              Job[]
  accessGrants      WorkspaceAccessGrant[]
  inviteAssignments InviteWorkspaceAssignment[]

  @@index([companyId])
  @@index([orgUnitId])
}

model Crew {
  id        String   @id @default(cuid())
  companyId String
  orgUnitId String?
  name      String
  typeLabel String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnit           OrgUnit?                 @relation(fields: [orgUnitId], references: [id])
  memberships       CrewMembership[]
  inviteAssignments InviteCrewAssignment[]

  @@index([companyId])
  @@index([orgUnitId])
}

model CrewMembership {
  id                  String   @id @default(cuid())
  crewId              String
  companyMembershipId String
  createdAt           DateTime @default(now())

  crew              Crew              @relation(fields: [crewId], references: [id], onDelete: Cascade)
  companyMembership CompanyMembership @relation(fields: [companyMembershipId], references: [id], onDelete: Cascade)

  @@unique([crewId, companyMembershipId])
  @@index([companyMembershipId])
}

model OrgUnitMembership {
  id                  String   @id @default(cuid())
  orgUnitId           String
  companyMembershipId String
  createdAt           DateTime @default(now())

  orgUnit           OrgUnit           @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  companyMembership CompanyMembership @relation(fields: [companyMembershipId], references: [id], onDelete: Cascade)

  @@unique([orgUnitId, companyMembershipId])
  @@index([companyMembershipId])
}

model WorkspaceAccessGrant {
  id                    String              @id @default(cuid())
  companyId             String
  workspaceId           String
  principalType         AccessPrincipalType
  principalId           String
  createdByMembershipId String?
  createdAt             DateTime            @default(now())

  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMembership CompanyMembership? @relation("WorkspaceGrantCreator", fields: [createdByMembershipId], references: [id])

  @@unique([workspaceId, principalType, principalId])
  @@index([companyId])
  @@index([principalType, principalId])
}

model JobAccessGrant {
  id                    String              @id @default(cuid())
  companyId             String
  jobId                 String
  principalType         AccessPrincipalType
  principalId           String
  createdByMembershipId String?
  createdAt             DateTime            @default(now())

  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job                 Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdByMembership CompanyMembership? @relation("JobGrantCreator", fields: [createdByMembershipId], references: [id])

  @@unique([jobId, principalType, principalId])
  @@index([companyId])
  @@index([principalType, principalId])
}

model InviteOrgUnitAssignment {
  id        String   @id @default(cuid())
  inviteId  String
  orgUnitId String
  createdAt DateTime @default(now())

  invite  Invite  @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@unique([inviteId, orgUnitId])
}

model InviteCrewAssignment {
  id        String   @id @default(cuid())
  inviteId  String
  crewId    String
  createdAt DateTime @default(now())

  invite Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@unique([inviteId, crewId])
}

model InviteWorkspaceAssignment {
  id          String   @id @default(cuid())
  inviteId    String
  workspaceId String
  createdAt   DateTime @default(now())

  invite    Invite    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([inviteId, workspaceId])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

enum JobStatus {
  DESIGN
  ACTIVE // "N Days Left" will be calculated dynamically if targetCompletionDate is set
  DELAY
  PUNCH_LIST
  FINAL_BILL_SUBMITTED
  COMPLETE
}

model Job {
  id                   String    @id @default(cuid())
  companyId            String
  workspaceId          String?
  title                String
  jobNumber            String?
  poNumber             String?
  contractNumber       String?
  customerName         String?
  address              String?
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  status               JobStatus @default(ACTIVE)
  priority             Int       @default(3) // 1-5 scale
  targetCompletionDate DateTime?
  description          String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  createdBy User       @relation(fields: [createdById], references: [id])

  notes        Note[]
  files        File[]
  tasks        Task[]
  exports      Export[]
  accessGrants JobAccessGrant[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Notes & Progress Logs
// ---------------------------------------------------------------------------

enum NoteType {
  GENERAL
  PROGRESS
  DAILY_REPORT
}

model Note {
  id        String   @id @default(cuid())
  companyId String
  jobId     String? // If NULL, this is an Inbox Item
  authorId  String
  type      NoteType @default(GENERAL)
  content   String
  category  String? // e.g., "Material issue", "Customer conversation"

  statusTag        String? // Used for Progress logs
  reportDate       DateTime? // Used for Daily Reports
  materialsUsed    String?   // Used for Daily Reports
  clientMutationId String?

  createdAt DateTime @default(now()) // Can be set by client for offline captures
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  job     Job?    @relation(fields: [jobId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  files File[] @relation("NoteFiles")

  @@unique([companyId, clientMutationId])
}

// ---------------------------------------------------------------------------
// Photos & Files
// ---------------------------------------------------------------------------

enum FileType {
  PHOTO
  DOCUMENT
}

model File {
  id           String   @id @default(cuid())
  companyId    String
  jobId        String? // If NULL, this is an Inbox Item
  uploaderId   String
  type         FileType
  url          String
  originalName String
  name         String? // Edited or AI-suggested
  category     String? // Edited or AI-suggested
  contentType  String?
  sizeBytes    Int?

  // AI Metadata
  aiSuggestedName     String?
  aiSuggestedCategory String?

  noteId           String?
  taskId           String?
  markupMarkId     String?
  clientMutationId String?

  createdAt DateTime @default(now()) // Can be set by client for offline captures
  updatedAt DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id])
  job          Job?              @relation(fields: [jobId], references: [id])
  uploader     User              @relation(fields: [uploaderId], references: [id])
  note         Note?             @relation("NoteFiles", fields: [noteId], references: [id])
  task         Task?             @relation("TaskFiles", fields: [taskId], references: [id])
  markupMark   FileMarkupMark?   @relation("MarkupMarkFiles", fields: [markupMarkId], references: [id])
  markupMarks  FileMarkupMark[]
  markupExport FileMarkupExport?

  @@unique([companyId, clientMutationId])
}

// ---------------------------------------------------------------------------
// File markup (annotations) — re-editable marks + flattened export artifact
// ---------------------------------------------------------------------------

enum MarkupMarkKind {
  PEN
  ELLIPSE
  ARROW
  CLOUD
  PIN
}

model FileMarkupMark {
  id              String         @id // client-generated (uuid) — stable across offline replay
  fileId          String
  companyId       String // scoping, mirrors File
  authorId        String
  page            Int            @default(1) // 1-based; images = page 1
  kind            MarkupMarkKind
  geometry        Json // normalized 0..1 coordinates
  style           Json // { color, strokeWidth, opacity }
  text            String? // PIN comment
  sequence        Int            @default(0) // creation order → pin numbering
  deletedAt       DateTime? // soft delete so deletes merge across clients
  clientUpdatedAt DateTime // client timestamp → per-mark last-write-wins
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  file   File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
  files  File[] @relation("MarkupMarkFiles")
  sourceTask Task? @relation("TaskSourceMarkupMark")

  @@index([fileId])
  @@index([companyId])
}

model FileMarkupExport {
  id          String    @id @default(cuid())
  fileId      String    @unique // 1:1 with the original File
  storageKey  String? // R2 key of the flattened PDF
  contentType String    @default("application/pdf")
  isStale     Boolean   @default(true) // true whenever a mark changes after last export
  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Tasks & Punch List
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskType {
  TASK
  PUNCH_LIST
}

model Task {
  id          String     @id @default(cuid())
  companyId   String
  jobId       String
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  type        TaskType   @default(TASK)
  priority    Int?
  dueDate     DateTime?

  createdById      String
  assignedToId     String?
  sourceMarkupMarkId String? @unique
  clientMutationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  job        Job     @relation(fields: [jobId], references: [id])
  createdBy  User    @relation(fields: [createdById], references: [id])
  assignedTo User?   @relation("AssignedTasks", fields: [assignedToId], references: [id])
  sourceMarkupMark FileMarkupMark? @relation("TaskSourceMarkupMark", fields: [sourceMarkupMarkId], references: [id])

  files File[] @relation("TaskFiles")

  @@unique([companyId, clientMutationId])
}

// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------

model Export {
  id           String    @id @default(cuid())
  jobId        String
  createdById  String
  destination  String // "ZIP" | "SHARE_LINK" | "GOOGLE_DRIVE" | "ONEDRIVE"
  status       String // "PENDING" | "PROCESSING" | "READY" | "FAILED" | "EXPIRED"
  optionsJson  String // Stores serialized selection options
  fileName     String?
  storageKey   String? // R2 key for the generated ZIP
  downloadUrl  String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}
