// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & Users
// ---------------------------------------------------------------------------

enum PlanType {
  FREE
  PAID
}

model Company {
  id               String   @id @default(cuid())
  name             String
  plan             PlanType @default(FREE)
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  jobs             Job[]
  notes            Note[]
  files            File[]
  tasks            Task[]
  invites          Invite[]
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id             String   @id @default(cuid())
  companyId      String?
  email          String?  @unique // Nullable to support SMS invites
  emailVerified  DateTime?
  image          String?
  phone          String?  @unique
  name           String?
  role           Role     @default(MEMBER)
  hashedPassword String?

  company        Company? @relation(fields: [companyId], references: [id])
  accounts       Account[]
  sessions       Session[]
  
  jobsCreated    Job[]
  notes          Note[]
  files          File[]
  tasksCreated   Task[]
  tasksAssigned  Task[]   @relation("AssignedTasks")
  exports        Export[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Invite {
  id         String    @id @default(cuid())
  companyId  String
  email      String
  role       Role      @default(MEMBER)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

enum JobStatus {
  DESIGN
  ACTIVE      // "N Days Left" will be calculated dynamically if targetCompletionDate is set
  DELAY
  PUNCH_LIST
  FINAL_BILL_SUBMITTED
  COMPLETE
}

model Job {
  id                   String    @id @default(cuid())
  companyId            String
  title                String
  jobNumber            String?
  poNumber             String?
  contractNumber       String?
  customerName         String?
  address              String?
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  status               JobStatus @default(ACTIVE)
  priority             Int       @default(3) // 1-5 scale
  targetCompletionDate DateTime?
  description          String?
  
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company              Company   @relation(fields: [companyId], references: [id])
  createdBy            User      @relation(fields: [createdById], references: [id])
  
  notes                Note[]
  files                File[]
  tasks                Task[]
  exports              Export[]
}

// ---------------------------------------------------------------------------
// Notes & Progress Logs
// ---------------------------------------------------------------------------

enum NoteType {
  GENERAL
  PROGRESS
}

model Note {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String?  // If NULL, this is an Inbox Item
  authorId    String
  type        NoteType @default(GENERAL)
  content     String
  category    String?  // e.g., "Material issue", "Customer conversation"
  
  statusTag   String?  // Used for Progress logs
  clientMutationId String?

  createdAt   DateTime @default(now()) // Can be set by client for offline captures
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  job         Job?     @relation(fields: [jobId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
  
  files       File[]   @relation("NoteFiles")

  @@unique([companyId, clientMutationId])
}

// ---------------------------------------------------------------------------
// Photos & Files
// ---------------------------------------------------------------------------

enum FileType {
  PHOTO
  DOCUMENT
}

model File {
  id                   String   @id @default(cuid())
  companyId            String
  jobId                String?  // If NULL, this is an Inbox Item
  uploaderId           String
  type                 FileType
  url                  String
  originalName         String
  name                 String?  // Edited or AI-suggested
  category             String?  // Edited or AI-suggested
  
  // AI Metadata
  aiSuggestedName      String?
  aiSuggestedCategory  String?

  noteId               String?
  taskId               String?
  clientMutationId     String?

  createdAt            DateTime @default(now()) // Can be set by client for offline captures
  updatedAt            DateTime @updatedAt

  company              Company  @relation(fields: [companyId], references: [id])
  job                  Job?     @relation(fields: [jobId], references: [id])
  uploader             User     @relation(fields: [uploaderId], references: [id])
  note                 Note?    @relation("NoteFiles", fields: [noteId], references: [id])
  task                 Task?    @relation("TaskFiles", fields: [taskId], references: [id])

  @@unique([companyId, clientMutationId])
}

// ---------------------------------------------------------------------------
// Tasks & Punch List
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskType {
  TASK
  PUNCH_LIST
}

model Task {
  id           String     @id @default(cuid())
  companyId    String
  jobId        String
  title        String
  description  String?
  status       TaskStatus @default(OPEN)
  type         TaskType   @default(TASK)
  priority     Int?
  dueDate      DateTime?
  
  createdById  String
  assignedToId String?
  clientMutationId String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company      Company    @relation(fields: [companyId], references: [id])
  job          Job        @relation(fields: [jobId], references: [id])
  createdBy    User       @relation(fields: [createdById], references: [id])
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  
  files        File[]     @relation("TaskFiles")

  @@unique([companyId, clientMutationId])
}

// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------

model Export {
  id              String    @id @default(cuid())
  jobId           String
  createdById     String
  destination     String    // "ZIP" | "SHARE_LINK" | "GOOGLE_DRIVE" | "ONEDRIVE"
  status          String    // "PENDING" | "PROCESSING" | "READY" | "FAILED" | "EXPIRED"
  optionsJson     String    // Stores serialized selection options
  fileName        String?
  storageKey      String?   // R2 key for the generated ZIP
  downloadUrl     String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  errorMessage    String?

  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy       User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

